diff --git a/tests/gateway/test_idempotent_delivery.py b/tests/gateway/test_idempotent_delivery.py
new file mode 100644
index 0000000000..6e46a1d1d5
--- /dev/null
+++ b/tests/gateway/test_idempotent_delivery.py
@@ -0,0 +1,206 @@
+"""Idempotent transports keep one identity across native final-reply recovery.
+
+The ordinary Feishu contract stays best-effort with visible recovery markers.
+No network, platform credentials, or user Hermes state are used.
+"""
+
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from gateway import delivery_ledger as dl
+from gateway.config import Platform, PlatformConfig
+from gateway.platforms.base import BasePlatformAdapter, SendResult
+from gateway.platforms.event import MessageEvent
+from gateway.run import GatewayRunner
+from gateway.session import SessionSource
+
+
+class _Adapter(BasePlatformAdapter):
+    def __init__(self, *, idempotent=True, accepted=None, platform=Platform.FEISHU):
+        super().__init__(PlatformConfig(enabled=True), platform)
+        self.idempotent_delivery = idempotent
+        self.accepted = {} if accepted is None else accepted
+        self.requests = []
+        self.lose_ack = False
+
+    async def connect(self, *, is_reconnect=False):
+        return True
+
+    async def disconnect(self):
+        pass
+
+    async def get_chat_info(self, chat_id):
+        return {"name": chat_id}
+
+    def _send_retry_is_final(self, result):
+        return True
+
+    async def send(self, chat_id, content, reply_to=None, metadata=None):
+        self.requests.append((chat_id, content, metadata))
+        identity = (metadata or {}).get("delivery_id")
+        if identity:
+            previous = self.accepted.setdefault(identity, content)
+            assert previous == content, "one identity must never change payload"
+        if self.lose_ack:
+            return SendResult(success=False, error="send_path_degraded")
+        return SendResult(success=True, message_id="m1")
+
+
+@pytest.fixture(autouse=True)
+def _isolated_ledger(tmp_path, monkeypatch):
+    monkeypatch.setattr(dl, "_db_path", lambda: tmp_path / "state.db")
+
+
+def _event(platform=Platform.FEISHU):
+    return MessageEvent(text="question", message_id="inbound-42",
+                        source=SessionSource(platform=platform, chat_id="chat-1", chat_type="dm"))
+
+
+def _rows():
+    with dl._connect() as db:
+        return db.execute("SELECT obligation_id,state,content FROM delivery_obligations").fetchall()
+
+
+def _runner(adapter):
+    runner = object.__new__(GatewayRunner)
+    runner.adapters = {adapter.platform: adapter}
+    runner._profile_adapters = {}
+    runner._active_profile_name = lambda: "default"
+    runner.session_store = None
+    runner._async_session_store = MagicMock()
+    runner._async_session_store.clear_resume_pending = AsyncMock()
+    runner._async_session_store._store = None
+    runner._running = False
+    return runner
+
+
+async def _live(adapter, event=None, metadata=None):
+    return await adapter.send_final_ledgered(
+        event or _event(adapter.platform), "agent:main:feishu:dm:chat-1", "original reply",
+        metadata or {}, reply_to="inbound-42")
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("recovery", ["boot", "runtime"])
+async def test_lost_ack_reuses_original_identity_and_body(recovery):
+    original = _Adapter()
+    original.lose_ack = True
+    metadata = {"notify": True}
+    result, _ = await _live(original, metadata=metadata)
+    assert not result.success
+    identity = _rows()[0][0]
+    assert original.requests[0][2] == {"notify": True, "delivery_id": identity}
+    assert metadata == {"notify": True}
+
+    restored = _Adapter(accepted=original.accepted)
+    runner = _runner(restored)
+    if recovery == "boot":
+        with dl._connect() as db:
+            db.execute("UPDATE delivery_obligations SET owner_pid=999999999,owner_started_at=1")
+        assert await runner._redeliver_pending_obligations() == 1
+    else:
+        assert await runner._redeliver_failed_obligations_for_platform(Platform.FEISHU) == 1
+    assert restored.requests == [("chat-1", "original reply", {"delivery_id": identity})]
+    assert restored.accepted == {identity: "original reply"}
+    assert _rows() == [(identity, "delivered", "original reply")]
+    assert await runner._redeliver_pending_obligations() == 0
+
+
+@pytest.mark.asyncio
+async def test_default_feishu_keeps_marker_and_metadata_contract():
+    adapter = _Adapter(idempotent=False)
+    adapter.lose_ack = True
+    await _live(adapter)
+    assert adapter.requests == [("chat-1", "original reply", {})]
+    adapter.lose_ack = False
+    runner = _runner(adapter)
+    assert await runner._redeliver_failed_obligations_for_platform(Platform.FEISHU) == 1
+    assert adapter.requests[-1] == ("chat-1", dl.RECONNECTED_MARKER + "original reply", None)
+
+
+@pytest.mark.asyncio
+async def test_internal_turns_with_identical_replies_keep_distinct_ids():
+    adapter = _Adapter()
+    for token in ("first-turn", "second-turn"):
+        event = _event()
+        event.message_id = None
+        event.internal = True
+        event._gateway_active_turn_token = token
+        result, _ = await _live(adapter, event)
+        assert result.success
+    assert len(adapter.accepted) == 2
+    assert len(_rows()) == 2
+
+
+@pytest.mark.asyncio
+async def test_idempotent_internal_reply_requires_durable_turn_identity():
+    adapter = _Adapter()
+    event = _event()
+    event.message_id = None
+    event.internal = True
+    result, _ = await _live(adapter, event)
+    assert (result.success, result.error) == (False, "delivery_ledger_unavailable")
+    assert adapter.requests == []
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("failure", ["record_obligation", "mark_attempting", "ledger_disabled"])
+async def test_idempotent_final_never_sends_without_durable_ledger(failure, monkeypatch):
+    adapter = _Adapter()
+    event = _event()
+    event._turn_marker_handoff = True
+    event._gateway_active_turn_token = "durable-token"
+    runner = _runner(adapter)
+    runner._clear_durable_active_turn = AsyncMock()
+    adapter.gateway_runner = runner
+    if failure == "ledger_disabled":
+        monkeypatch.setattr(dl, "ledger_enabled", lambda: False)
+    else:
+        def unavailable(*args, **kwargs):
+            raise OSError("simulated storage unavailable")
+        monkeypatch.setattr(dl, failure, unavailable)
+    result, _ = await _live(adapter, event)
+    assert (result.success, result.error) == (False, "delivery_ledger_unavailable")
+    assert adapter.requests == []
+    # The background task's final cleanup must not discard the only recovery marker.
+    await adapter._release_turn_marker(event)
+    runner._clear_durable_active_turn.assert_not_awaited()
+    assert event._gateway_active_turn_token == "durable-token"
+
+
+@pytest.mark.asyncio
+async def test_default_feishu_still_sends_when_ledger_unavailable(monkeypatch):
+    def unavailable(**kwargs):
+        raise OSError("simulated storage unavailable")
+    monkeypatch.setattr(dl, "record_obligation", unavailable)
+    adapter = _Adapter(idempotent=False)
+    result, _ = await _live(adapter)
+    assert result.success
+    assert adapter.requests == [("chat-1", "original reply", {})]
+
+
+@pytest.mark.asyncio
+async def test_crash_left_transcript_gets_durable_id_without_regenerating(tmp_path):
+    from tests.gateway.test_active_turn_recovery import (
+        _close_store_db, _db_runner, _entry_for, _turn,
+    )
+
+    runner, store = _db_runner(tmp_path)
+    source = _turn(store, "replied", marked=True, reply="original reply")
+    adapter = _Adapter(platform=source.platform)
+    runner.adapters = {source.platform: adapter}
+    runner._profile_adapters = {}
+    runner._active_profile_name = lambda: "default"
+    runner._running = False
+    try:
+        assert await runner._recover_unclean_sessions() == (0, 1)
+        assert await runner._redeliver_pending_obligations() == 1
+        identity = _rows()[0][0]
+        assert adapter.requests == [("replied", "original reply",
+                                     {"thread_id": "thread-1", "delivery_id": identity})]
+        assert not _entry_for(store, source).resume_pending
+        assert await runner._recover_unclean_sessions() == (0, 0)
+        assert await runner._redeliver_pending_obligations() == 0
+    finally:
+        _close_store_db(store)
