@@ -0,0 +1,64 @@
+"""Durable final-text obligations shared by platform adapters."""
+from __future__ import annotations
+
+import asyncio
+import logging
+from typing import Any
+
+from gateway.platforms.event import MessageEvent
+
+logger = logging.getLogger(__name__)
+
+
+async def record_delivery_obligation(
+    event: MessageEvent, session_key: str, text_content: str, delivery_adapter: Any, *,
+    is_ephemeral_response: bool, typed_command_prefix: str,
+) -> str | None:
+    """Record before HTTP; idempotent transports refuse sends when recording fails.
+
+    Command and ephemeral replies keep their separate delivery behavior. Other
+    adapters retain the historical best-effort ledger policy.
+    """
+    event._delivery_ledger_unavailable = False
+    if is_ephemeral_response or str(event.text or "").lstrip().startswith(
+        ("/", typed_command_prefix or "!")):
+        return None
+    try:
+        from gateway.delivery_ledger import (
+            compute_obligation_id, ledger_enabled, mark_attempting, record_obligation)
+        if not await asyncio.to_thread(ledger_enabled):
+            if getattr(delivery_adapter, "idempotent_delivery", False) is True:
+                raise RuntimeError("idempotent delivery requires the delivery ledger")
+            return None
+        source = event.source
+        # ``ledger_message_id`` wins when set: a queued chain's final answers the last message
+        # of the chain, not the event that opened it (see ``MessageEvent.ledger_message_id``).
+        _ledger_id = getattr(event, "ledger_message_id", None)
+        if _ledger_id is None:
+            _ledger_id = getattr(event, "message_id", "")
+        if not _ledger_id and getattr(delivery_adapter, "idempotent_delivery", False) is True:
+            # Internal/resumed turns have no inbound id. Distinct turns may
+            # legitimately answer with identical text; never merge them.
+            token = getattr(event, "_gateway_active_turn_token", None)
+            if not token:
+                raise RuntimeError("idempotent delivery requires a durable turn identity")
+            _ledger_id = "turn:" + str(token)
+        obligation_id = compute_obligation_id(
+            session_key, str(_ledger_id or ""), text_content)
+        await asyncio.to_thread(
+            record_obligation, obligation_id=obligation_id, session_key=session_key,
+            platform=str(getattr(source.platform, "value", source.platform)),
+            chat_id=source.chat_id, thread_id=getattr(source, "thread_id", None),
+            content=text_content,
+            adapter_profile=getattr(delivery_adapter, "_owner_profile", None))
+        await asyncio.to_thread(mark_attempting, obligation_id)
+        return obligation_id
+    except Exception:
+        if getattr(delivery_adapter, "idempotent_delivery", False) is True:
+            # No transport request may escape without a recoverable identity.
+            # Keep the marker for possible unclean-start recovery of the transcript.
+            event._delivery_ledger_unavailable = True
+            logger.warning("Idempotent final send deferred: delivery ledger unavailable", exc_info=True)
+            return None
+        logger.debug("delivery ledger record failed", exc_info=True)
+        return None
