+++ b/tests/gateway/test_idempotent_marker_lifecycle.py
@@ -0,0 +1,171 @@
+"""Storage failure keeps the recovery token without stalling the live session FIFO."""
+
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from gateway import delivery_ledger as dl
+from gateway.session_authority import SessionAuthority
+from gateway.session_ingress import busy_acceptance, deliver_settled, dispatch_shared_busy
+from tests.gateway.test_idempotent_delivery import _Adapter, _event, _runner
+
+
+@pytest.fixture(autouse=True)
+def _isolated_ledger(tmp_path, monkeypatch):
+    monkeypatch.setattr(dl, "_db_path", lambda: tmp_path / "state.db")
+
+
+def _authority(adapter, event):
+    runner = _runner(adapter)
+    runner._draining = False
+
+    async def clear_marker(current):
+        current._gateway_active_turn_token = None
+
+    runner._clear_durable_active_turn = AsyncMock(side_effect=clear_marker)
+    adapter.gateway_runner = runner
+    event._turn_marker_handoff = True
+    event._gateway_active_turn_token = "original-turn"
+    authority = object.__new__(SessionAuthority)
+    authority.runner = runner
+    authority.retiring = False
+    authority.marker_adopters = {"admission": event}
+    authority.waiters = {"admission": asyncio.get_running_loop().create_future()}
+    authority.native_waiters = set()
+    authority.pending_deliveries = {}
+    authority.held_turn_markers = {}
+    return authority
+
+
+def _fail_ledger(monkeypatch, failure):
+    if failure == "ledger_disabled":
+        monkeypatch.setattr(dl, "ledger_enabled", lambda: False)
+    else:
+        def unavailable(*args, **kwargs):
+            raise OSError("simulated storage unavailable")
+        monkeypatch.setattr(dl, failure, unavailable)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("failure", ["record_obligation", "mark_attempting", "ledger_disabled", None])
+async def test_waiting_fifo_is_not_stalled_by_preserved_recovery_marker(failure, monkeypatch):
+    adapter, event = _Adapter(), _event()
+    authority = _authority(adapter, event)
+    if failure:
+        _fail_ledger(monkeypatch, failure)
+    waiter = authority.waiters["admission"]
+    settlement = asyncio.create_task(authority._resolve_settled_waiter("admission", "reply"))
+    try:
+        assert await asyncio.wait_for(asyncio.shield(waiter), 2) == "reply"
+        # The real authority creates the notification before waking the sending adapter.
+        assert not event._gateway_marker_released.is_set()
+        result, _ = await adapter.send_final_ledgered(
+            event, "route", "reply", {}, reply_to=event.message_id)
+        await adapter._release_turn_marker(event)  # background delivery's finally
+        await asyncio.wait_for(asyncio.shield(settlement), 2)
+        assert event._gateway_marker_released.is_set()
+        if failure:
+            assert (result.success, result.error) == (False, "delivery_ledger_unavailable")
+            assert adapter.requests == []
+            assert event._gateway_active_turn_token == "original-turn"
+            authority.runner._clear_durable_active_turn.assert_not_awaited()
+        else:
+            assert result.success and len(adapter.requests) == 1
+            assert event._gateway_active_turn_token is None
+            authority.runner._clear_durable_active_turn.assert_awaited_once_with(event)
+    finally:
+        settlement.cancel()
+        await asyncio.gather(settlement, return_exceptions=True)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("state", ["draining", "retiring"])
+async def test_drain_and_retire_do_not_wait_for_adapter_notification(state, monkeypatch):
+    adapter, event = _Adapter(), _event()
+    authority = _authority(adapter, event)
+    authority.runner._draining = state == "draining"
+    authority.retiring = state == "retiring"
+    _fail_ledger(monkeypatch, "record_obligation")
+    waiter = authority.waiters["admission"]
+    await asyncio.wait_for(authority._resolve_settled_waiter("admission", "reply"), 2)
+    assert waiter.result() == "reply"
+    assert not event._gateway_marker_released.is_set()
+    result, _ = await adapter.send_final_ledgered(event, "route", "reply", {}, reply_to=event.message_id)
+    await adapter._release_turn_marker(event)
+    assert not result.success and not adapter.requests
+    assert event._gateway_marker_released.is_set()
+    assert event._gateway_active_turn_token == "original-turn"
+    authority.runner._clear_durable_active_turn.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("failure", [True, False])
+async def test_recovered_no_waiter_reply_keeps_marker_only_when_ledger_fails(failure, monkeypatch):
+    adapter, event = _Adapter(), _event()
+    authority = _authority(adapter, event)
+    authority.marker_adopters.clear()
+    authority.waiters.clear()
+    authority.held_turn_markers["admission"] = event
+    authority.pending_deliveries["admission"] = (adapter, event, "route", "reply", None)
+    # Exercise the actual settled delivery and ledger bracket, with no media side effects.
+    adapter._extract_response_content = AsyncMock(return_value=SimpleNamespace(text_content="reply"))
+    adapter._deliver_attachments = AsyncMock()
+    if failure:
+        _fail_ledger(monkeypatch, "record_obligation")
+    await deliver_settled(authority, "admission")
+    assert authority.pending_deliveries == {}
+    assert authority.held_turn_markers == {}
